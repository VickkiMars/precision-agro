# Keep the Docker build context (uploaded on every Vercel build) minimal.
# Notebooks, the 26 MB ResNet-9 checkpoint and the DOCX are only used on the
# edge device / in analysis, never by the web container.

# --- Heavy artifacts not needed by the GCS container ---
*.pth
*.h5
*.pt
*.ipynb_checkpoints/
*.ipynb
*.docx
*.pdf

# --- Python noise ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# --- Test scratch output ---
test_crop_health.db*
test_prescription_log.csv
test_prescription_map.geojson

# --- Local / platform config that must not ship ---
.git/
.gitignore
.vercel/
.vercelignore
.env
.env.*
*.log
.DS_Store

# --- Edge-only hardware bindings (no MAVLink / CSI camera in a container) ---
flight_controller.py
mission_runner.py
