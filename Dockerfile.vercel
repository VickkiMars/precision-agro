# ==============================================================================
# Precision Agriculture GCS - Vercel Container Deployment
# Target: Vercel Dockerfile Deployment (Hobby & Pro)
# Base: Python 3.12 Slim Linux Container
# Runtime: stdlib http.server — zero third-party wheels, fast cold starts
# Port: Listens dynamically on $PORT (defaults to 80 for Vercel)
# ==============================================================================

FROM python:3.12-slim

# Prevent .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=80 \
    DATA_DIR=/tmp/gcs

WORKDIR /app

# Copy entrypoint script and make executable
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Copy application source and seeded agronomic data assets
COPY gcs_server.py db_init.py prescription_engine.py \
     drone_streamer.py flight_controller.py \
     crop_health_edge.db camera_config.json \
     field_prescription_log.csv field_prescription_map.geojson \
     plant_classes.json index.html \
     requirements.txt \
     /app/

# Copy real-time capture dataset for optical stream simulation
COPY realtime_captures /app/realtime_captures

# Ephemeral scratch space for the stateless container
RUN mkdir -p /tmp/gcs && chmod -R 1777 /tmp/gcs

# Vercel defaults HTTP traffic to port 80
EXPOSE 80

# Zero-dependency healthcheck probe using Python stdlib
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request, os, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','80')+'/healthz', timeout=3).getcode()==200 else 1)" || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]

# Bind dynamically to $PORT (Vercel injects it; defaults to 80)
CMD ["sh", "-c", "exec python gcs_server.py"]
